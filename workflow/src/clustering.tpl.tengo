self := import("@platforma-sdk/workflow-tengo:tpl")
exec := import("@platforma-sdk/workflow-tengo:exec")
assets := import("@platforma-sdk/workflow-tengo:assets")

math := import("math")

prepareInputSw := assets.importSoftware("@platforma-open/milaboratories.tcr-clustering.software:prepare-input")
// clusTCR runs as a Python library inside its conda env (entrypoint cmd: ["python"]). The conda
// package carries no source, so prepare-input surfaces run_clustcr.py (bundled in the software
// package) as a file output, and the clustering step addFile's it into the conda env to run it.
clustcrSw := assets.importSoftware("@platforma-open/milaboratories.software-clustcr:main")
processResultsSw := assets.importSoftware("@platforma-open/milaboratories.tcr-clustering.software:process-results")
createEmptyFilesSw := assets.importSoftware("@platforma-open/milaboratories.tcr-clustering.software:create-empty-files")

self.validateInputs({
	"__options__,closed": "",
	emptyOrNot: "any",
	seqTable: "any",
	cloneTable: "any",
	isSingleCell: "boolean",
	numSequences: "number",
	inflation: "number",
	"consensusThreshold,?": "number",
	"weightByAbundance,?": "boolean",
	"mem,?": "number",
	"cpu,?": "number"
})

self.defineOutputs("abundances", "clusterToSeq", "cloneToCluster", "abundancesPerCluster", "distanceToCentroid",
	"clusterRadius", "clusterToSeqTop", "clusterRadiusTop", "abundancesTop", "sequences", "clustcr",
	"clustcrLog", "isEmpty")

self.body(func(inputs) {
	seqTable := inputs.seqTable
	cloneTable := inputs.cloneTable
	numSequences := inputs.numSequences
	inflation := inputs.inflation
	consensusThreshold := is_undefined(inputs.consensusThreshold) ? 0.6 : inputs.consensusThreshold
	weightByAbundance := is_undefined(inputs.weightByAbundance) ? false : inputs.weightByAbundance
	isSingleCell := inputs.isSingleCell

	baseMemGiB := 32
	if !is_undefined(inputs.mem) {
		baseMemGiB = inputs.mem
	}
	cpu := 16
	if !is_undefined(inputs.cpu) {
		cpu = inputs.cpu
	}

	if string(inputs.emptyOrNot.getData()) == "empty" {
		// Empty input: header-only files with the same schema the real run produces.
		emptyFilesBuilder := exec.builder().
			software(createEmptyFilesSw).
			mem("1GiB").
			cpu(1).
			arg("--num-sequences").arg(string(numSequences))
		if isSingleCell {
			emptyFilesBuilder = emptyFilesBuilder.arg("--is-single-cell")
		}
		emptyFiles := emptyFilesBuilder.
			saveFile("abundances.tsv").
			saveFile("cluster-to-seq.tsv").
			saveFile("clone-to-cluster.tsv").
			saveFile("abundances-per-cluster.tsv").
			saveFile("distance_to_centroid.tsv").
			saveFile("cluster-radius.tsv").
			saveFile("cluster-to-seq-top.tsv").
			saveFile("cluster-radius-top.tsv").
			saveFile("abundances-top.tsv").
			saveFile("sequences.tsv").
			run()

		return {
			abundances: emptyFiles.getFile("abundances.tsv"),
			clusterToSeq: emptyFiles.getFile("cluster-to-seq.tsv"),
			cloneToCluster: emptyFiles.getFile("clone-to-cluster.tsv"),
			abundancesPerCluster: emptyFiles.getFile("abundances-per-cluster.tsv"),
			distanceToCentroid: emptyFiles.getFile("distance_to_centroid.tsv"),
			clusterRadius: emptyFiles.getFile("cluster-radius.tsv"),
			clusterToSeqTop: emptyFiles.getFile("cluster-to-seq-top.tsv"),
			clusterRadiusTop: emptyFiles.getFile("cluster-radius-top.tsv"),
			abundancesTop: emptyFiles.getFile("abundances-top.tsv"),
			sequences: emptyFiles.getFile("sequences.tsv"),
			clustcr: {},
			clustcrLog: {},
			isEmpty: true
		}
	} else {
		// Step 1: dedup the clustering columns to unique rows -> input.csv + dedup_mapping.tsv.
		prep := exec.builder().
			software(prepareInputSw).
			mem(string(int(math.max(16, baseMemGiB / 4))) + "GiB").
			cpu(1).
			addFile("input.tsv", seqTable).
			saveFile("input.csv").
			saveFile("dedup_mapping.tsv").
			saveFile("run_clustcr.py").
			run()

		// Step 2: cluster the unique sequences with clusTCR, in its conda env. run_clustcr.py is
		// staged from prepare-input's output (the conda env ships no source of its own). clusTCR is
		// non-deterministic, so save the raw assignment in the output: identical inputs then dedup
		// by content instead of re-running (CID-conflict guard).
		clustering := exec.builder().
			software(clustcrSw).
			mem(string(baseMemGiB) + "GiB").
			cpu(cpu).
			printErrStreamToStdout().
			addFile("run_clustcr.py", prep.getFile("run_clustcr.py")).
			addFile("input.csv", prep.getFile("input.csv")).
			arg("run_clustcr.py").
			arg("input.csv").
			arg("output.csv").
			arg(string(cpu)).
			arg("--inflation").arg(string(inflation)).
			saveFile("output.csv").
			saveStdoutStream().
			run()

		clusters := clustering.getFile("output.csv")
		clustcrLog := clustering.getStdoutStream()

		// Step 3: expand to clonotypes, kalign centroid/medoid/distance, medoid-relabel -> TSVs.
		resultBuilder := exec.builder().
			software(processResultsSw).
			mem(string(int(math.max(32, baseMemGiB / 2))) + "GiB").
			cpu(8).
			addFile("clusters.csv", clusters).
			addFile("cloneTable.tsv", cloneTable).
			addFile("dedup_mapping.tsv", prep.getFile("dedup_mapping.tsv")).
			arg("--consensus-threshold").arg(string(consensusThreshold))

		if !weightByAbundance {
			resultBuilder = resultBuilder.arg("--no-abundance-weighting")
		}

		result := resultBuilder.
			saveFile("abundances.tsv").
			saveFile("cluster-to-seq.tsv").
			saveFile("clone-to-cluster.tsv").
			saveFile("abundances-per-cluster.tsv").
			saveFile("distance_to_centroid.tsv").
			saveFile("cluster-radius.tsv").
			saveFile("cluster-to-seq-top.tsv").
			saveFile("cluster-radius-top.tsv").
			saveFile("abundances-top.tsv").
			saveFile("sequences.tsv").
			run()

		return {
			abundances: result.getFile("abundances.tsv"),
			clusterToSeq: result.getFile("cluster-to-seq.tsv"),
			cloneToCluster: result.getFile("clone-to-cluster.tsv"),
			abundancesPerCluster: result.getFile("abundances-per-cluster.tsv"),
			distanceToCentroid: result.getFile("distance_to_centroid.tsv"),
			clusterRadius: result.getFile("cluster-radius.tsv"),
			clusterToSeqTop: result.getFile("cluster-to-seq-top.tsv"),
			clusterRadiusTop: result.getFile("cluster-radius-top.tsv"),
			abundancesTop: result.getFile("abundances-top.tsv"),
			sequences: result.getFile("sequences.tsv"),
			// save the raw assignment so the non-deterministic clustering step dedups by content
			clustcr: clusters,
			clustcrLog: clustcrLog,
			isEmpty: false
		}
	}
})
