ll := import("@platforma-sdk/workflow-tengo:ll")
text := import("text")

// Block label (custom overrides default). The default is the block name with what was
// clustered — the chosen CDR3 column's native label without the trailing " Primary" of
// single-cell data, plus " + V gene" when V genes join the clustering — followed by the settings.
build := func(args, columns, sel) {
	traceLabel := args.customBlockLabel
	if traceLabel == "" {
		labelParts := []
		if sel.mode == "paired" {
			labelParts = append(labelParts, "Paired (α + β)")
		} else {
			annotations := columns.getSpec(sel.sequenceRef).annotations
			label := is_undefined(annotations) ? undefined : annotations["pl7.app/label"]
			if !is_undefined(label) && label != "" {
				label = text.re_replace(`(?i)\s+Primary$`, label, "")
				if !is_undefined(sel.vGeneRef) {
					label = label + " + V gene"
				}
				labelParts = append(labelParts, label)
			}
		}
		if args.paramsLabel != "" {
			labelParts = append(labelParts, args.paramsLabel)
		}
		traceLabel = "ImmuneWatch ClusTCR"
		if len(labelParts) > 0 {
			traceLabel = "ImmuneWatch ClusTCR (" + text.join(labelParts, ", ") + ")"
		}
	}
	return traceLabel
}

export ll.toStrict({
	build: build
})
